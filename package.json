{
  "name": "wyre",
  "version": "2.0.0",
  "private": true,
  "description": "Wyre desktop application for Windows, macOS and Linux, based on MangoDisk.",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "pnpm --dir app tauri:dev",
    "build": "pnpm --dir app tauri:build",
    "dist:win": "pnpm --dir app tauri:build",
    "dist:linux": "pnpm --dir app tauri:build:linux",
    "dist:mac": "pnpm --dir app tauri:build:mac"
  },
  "packageManager": "pnpm@11.13.1"
}
