{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "pwsh.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/sign-windows-file.ps1 target/release/Wyre.exe"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Wyre",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
